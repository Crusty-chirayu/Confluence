# =============================================================================
# Confluence — AI Chat Platform (v2.0) · environment variables
#
# Copy to `.env.local` and fill in the values. With **no** Supabase variables
# present the app boots into DEMO MODE (in-browser store + simulated
# streaming assistant). Add the keys below to switch to the real backend.
# =============================================================================

# --- Frontend (client-safe, public) ------------------------------------------
# Public Supabase project URL and anon key. These are safe to expose (see the
# Supabase dashboard → Project Settings → API for the anon/public key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Edge Functions (server-side, never exposed to the browser) --------------
# These are set via the Supabase CLI, not in .env.local:
#
#   supabase secrets set OPENROUTER_API_KEY=sk-or-...
#
# OPENROUTER_API_KEY      — OpenRouter API key (server only). The orchestrator
#                           talks to OpenRouter's OpenAI-compatible Chat
#                           Completions API (default model
#                           `anthropic/claude-sonnet-4.6`, override with AI_MODEL).
# OPENAI_API_KEY          — OPTIONAL, server only (attachment-processor and
#                           ai-orchestrator). Enables the semantic half of V3
#                           attachment retrieval: chunks are embedded with
#                           `text-embedding-3-small` (1536 dimensions, matching
#                           the `attachment_chunks.embedding` column) on ingest,
#                           and each question is embedded before retrieval.
#                           WITHOUT it no embeddings are ever written, the
#                           pgvector leg is skipped, and retrieval runs on
#                           PostgreSQL full-text search alone — still correct and
#                           still conversation-scoped, but lexical rather than
#                           semantic. Every retrieved chunk reports the method
#                           that actually found it (`hybrid` / `vector` / `fts`),
#                           so nothing claims semantic search it did not do.
# TRAINING_PIPELINE_URL   — optional; when set, the orchestrator routes to it
#                           after the unanimous training-consent check
#
# --- CI / release (GitHub Actions repository secrets) ------------------------
# ci.yml build        : NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
# release.yml         : SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF,
#                       SUPABASE_DB_PASSWORD, VERCEL_TOKEN, VERCEL_ORG_ID,
#                       VERCEL_PROJECT_ID
